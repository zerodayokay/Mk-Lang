$mk.support.udivti3 = comdat nodeduplicate
$mk.support.umodti3 = comdat nodeduplicate
$mk.support.divti3 = comdat nodeduplicate
$mk.support.modti3 = comdat nodeduplicate

@mk.fr.mk.support.udivti3 = private constant { ptr, ptr, i32 } { ptr @mk.support.udivti3, ptr null, i32 2 }, section ".mkfn$M", comdat($mk.support.udivti3), align 8
@mk.fr.mk.support.umodti3 = private constant { ptr, ptr, i32 } { ptr @mk.support.umodti3, ptr null, i32 2 }, section ".mkfn$M", comdat($mk.support.umodti3), align 8
@mk.fr.mk.support.divti3 = private constant { ptr, ptr, i32 } { ptr @mk.support.divti3, ptr null, i32 2 }, section ".mkfn$M", comdat($mk.support.divti3), align 8
@mk.fr.mk.support.modti3 = private constant { ptr, ptr, i32 } { ptr @mk.support.modti3, ptr null, i32 2 }, section ".mkfn$M", comdat($mk.support.modti3), align 8
@_fltused = dso_local global i32 0, align 4
@llvm.used = appending global [5 x ptr] [ptr @memcpy, ptr @memmove, ptr @memset, ptr @memcmp, ptr @bcmp], section "llvm.metadata"
@llvm.compiler.used = appending global [4 x ptr] [ptr @mk.fr.mk.support.udivti3, ptr @mk.fr.mk.support.umodti3, ptr @mk.fr.mk.support.divti3, ptr @mk.fr.mk.support.modti3], section "llvm.metadata"

@__udivti3 = weak alias <2 x i64> (ptr, ptr), ptr @mk.support.udivti3
@__umodti3 = weak alias <2 x i64> (ptr, ptr), ptr @mk.support.umodti3
@__divti3 = weak alias <2 x i64> (ptr, ptr), ptr @mk.support.divti3
@__modti3 = weak alias <2 x i64> (ptr, ptr), ptr @mk.support.modti3

