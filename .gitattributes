# Mk sources, goldens and snapshots are LF everywhere: gofmt, archtest and
# the byte-exact snapshot tests read them as LF, so a Windows checkout with
# core.autocrlf=true must not convert them.
* text=auto eol=lf

# GitHub. Linguist takes .mk for a Makefile and does not know Mk, so .mk
# files are shown with Go's highlighting, the closest it has (keywords,
# strings, comments, [T] generics), and stay out of the language statistics.
*.mk linguist-language=Go linguist-detectable=false

# The C, Rust, Zig and Go programs the benchmarks compare Mk against.
tests/bench/**/*.c linguist-vendored
tests/bench/**/*.h linguist-vendored
tests/bench/**/*.rs linguist-vendored
tests/bench/**/*.zig linguist-vendored
tests/bench/**/*.go linguist-vendored
tests/bench-lanes/**/*.c linguist-vendored
tests/bench-lanes/**/*.h linguist-vendored
tests/bench-lanes/**/*.rs linguist-vendored
tests/bench-lanes/**/*.zig linguist-vendored
tests/bench-lanes/**/*.go linguist-vendored

# The system view archives mk embeds (internal/sysview): generated binary data.
internal/sysview/data/**/*.mksv binary linguist-generated
internal/sysview/data/**/views.txt linguist-generated
