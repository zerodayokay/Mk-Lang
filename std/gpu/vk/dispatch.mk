import std.raw

LoadInstanceProcAddr(get_addr: vulkan.PfnVkGetInstanceProcAddr, inst: vulkan.VkInstance, name: str): uint {
    match get_addr {
        some(g) {
            unsafe "vkGetInstanceProcAddr resolves a NUL-terminated Vulkan entry point" {
                p := g(inst, raw.StrData(name))
                match p {
                    some(f) {
                        var slot := f
                        return raw.Read(raw.PtrCast[fn(), uint](raw.Of(&slot)))
                    }
                    none { return 0 }
                }
            }
        }
        none { return 0 }
    }
}

LoadDeviceProcAddr(get_addr: vulkan.PfnVkGetDeviceProcAddr, dev: vulkan.VkDevice, name: str): uint {
    match get_addr {
        some(g) {
            unsafe "vkGetDeviceProcAddr resolves a NUL-terminated Vulkan device entry point" {
                p := g(dev, raw.StrData(name))
                match p {
                    some(f) {
                        var slot := f
                        return raw.Read(raw.PtrCast[fn(), uint](raw.Of(&slot)))
                    }
                    none { return 0 }
                }
            }
        }
        none { return 0 }
    }
}

