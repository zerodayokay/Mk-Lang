LoadGlobalDispatch(get_addr: vulkan.PfnVkGetInstanceProcAddr): ?GlobalDispatch {
    var g := mem.Zeroed[GlobalDispatch]()
    null_inst := raw.Null[vulkan.VkInstanceT]()
    unsafe "vkGetInstanceProcAddr addresses match c.vulkan PFN_vk* signatures" {
        g.vk_enumerate_instance_version = raw.FnFromAddr[vulkan.PfnVkEnumerateInstanceVersion](LoadInstanceProcAddr(get_addr, null_inst, "vkEnumerateInstanceVersion\x00"))
        g.vk_enumerate_instance_extension_properties = raw.FnFromAddr[vulkan.PfnVkEnumerateInstanceExtensionProperties](LoadInstanceProcAddr(get_addr, null_inst, "vkEnumerateInstanceExtensionProperties\x00"))
        g.vk_enumerate_instance_layer_properties = raw.FnFromAddr[vulkan.PfnVkEnumerateInstanceLayerProperties](LoadInstanceProcAddr(get_addr, null_inst, "vkEnumerateInstanceLayerProperties\x00"))
        g.vk_create_instance = raw.FnFromAddr[vulkan.PfnVkCreateInstance](LoadInstanceProcAddr(get_addr, null_inst, "vkCreateInstance\x00"))
        if g.vk_create_instance.IsNone() { return none }
    }
    return some(g)
}

