DecodeShader(a: &Arena, z_b64: str): compress.Error|encoding.Error![]u8 from a {
    raw := try encoding.Base64Decode(a, z_b64, encoding.Base64)
    return try compress.Inflate(a, raw, 4 * 1024 * 1024)
}

CheckShaderBlob(a: &Arena, z_b64: str, want_sha: str, want_magic: u32): compress.Error|encoding.Error!void {
    blob := try DecodeShader(a, z_b64)
    Assert(blob.Len() >= 4)
    magic := u32(blob[0]) | (u32(blob[1]) << 8) | (u32(blob[2]) << 16) | (u32(blob[3]) << 24)
    Assert(magic == want_magic)
    sum := hash.Sha256(blob)
    hex := try encoding.HexEncode(a, sum[..])
    Assert(hex.Eq(&want_sha))
}

