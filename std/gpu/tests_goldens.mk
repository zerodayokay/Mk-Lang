// Why: the device tests compare rendered scenes with WARP baselines
// keyed by the d3d10warp.dll version that produced them.
// What: generated by tools/gpugolden (do not edit): GoldenWarpVersion,
// each scene's Base64 PNG and SHA-256, DecodeGoldenImage, and a test
// that every golden matches its digest and decodes to 64x64.
// How: DecodeGoldenImage decodes the Base64, checks the SHA-256, then
// decodes the PNG with std.image.

import std.encoding
import std.hash
import std.image

const GoldenWarpVersion: str = "10.0.26100.10068"

const GoldenTrianglePngB64: str = ""
const GoldenTriangleSha256: str = "98db20037ca405713b21407a6bad0954b67992483da9fa2267ed3ea780654f13"

const GoldenIndexedTexturedQuadPngB64: str = ""
const GoldenIndexedTexturedQuadSha256: str = "f501a0bd8cd6a9f66d1d7fe57b3734098c4136dffff2d7b1040a5206d79228ba"

const GoldenDepthCubesPngB64: str = ""
const GoldenDepthCubesSha256: str = "dd36ee3148a29f8d7d71613de502e68e2885ba68ab768508304de242a620a2a4"

const GoldenInstancingPngB64: str = ""
const GoldenInstancingSha256: str = "e8556d599a09d06640def25e2f26cd03d0e4f935992e82a1f1dc008f40624cc0"

const GoldenMsaaResolvePngB64: str = ""
const GoldenMsaaResolveSha256: str = "113a11d10f5698e35729bf0dfbf98bdd601d646dd5e76478c7b1cb425102959c"

const GoldenBlendingPngB64: str = ""
const GoldenBlendingSha256: str = "20e9aef2836b1d32d6e726c4729be90effcbca7f7a7e1aad3ae13e5e9a91fa6b"

const GoldenMipChainPngB64: str = ""
const GoldenMipChainSha256: str = "9d4dc4a006b512dea0cc3378e7c0ce1d9e174d0404d1f695d8a4f2f3e95b4cfa"

const GoldenDepthSamplePngB64: str = "iVBORw0KGgoAAAANSUhEUgAAAEAAAABACAYAAACqaXHeAAAAlUlEQVR4nO3bQQqAIBBAUcs5jN7/gBME7gwKWukThAHd+HD7j8zMsvE6xwAAAAAAAADsBxBjeFq99xIR9661Tue/zr7cfXvWWhtP8QNmPwAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAKwIoBvUDeoGdYO6Qd2gbnDfbvAC4lULeTdAZ6QAAAAASUVORK5CYII="
const GoldenDepthSampleSha256: str = "0a98a4a78d68336d4e9c8d4d3cdd66a94f703ab10960e4f7f21972c27d50133c"

const GoldenComputePostPngB64: str = ""
const GoldenComputePostSha256: str = "fca7c7b704411cff1756c1b287c36fc3e369502b09c091f1d91a309a5f57c472"

GoldenScenePngData(idx: int): (b64: str, sha: str) {
    return match idx {
        0 { (b64: GoldenTrianglePngB64, sha: GoldenTriangleSha256) }
        1 { (b64: GoldenIndexedTexturedQuadPngB64, sha: GoldenIndexedTexturedQuadSha256) }
        2 { (b64: GoldenDepthCubesPngB64, sha: GoldenDepthCubesSha256) }
        3 { (b64: GoldenInstancingPngB64, sha: GoldenInstancingSha256) }
        4 { (b64: GoldenMsaaResolvePngB64, sha: GoldenMsaaResolveSha256) }
        5 { (b64: GoldenBlendingPngB64, sha: GoldenBlendingSha256) }
        6 { (b64: GoldenMipChainPngB64, sha: GoldenMipChainSha256) }
        7 { (b64: GoldenDepthSamplePngB64, sha: GoldenDepthSampleSha256) }
        _ { (b64: GoldenComputePostPngB64, sha: GoldenComputePostSha256) }
    }
}

DecodeGoldenImage(a: &Arena, idx: int): encoding.Error|image.Error!image.Image from a {
    (b64, sha) := GoldenScenePngData(idx)
    png := try encoding.Base64Decode(a, b64, encoding.Base64)
    sum := hash.Sha256(png)
    hex := try encoding.HexEncode(a, sum[..])
    Assert(hex.Eq(&sha))
    return try image.DecodePng(a, png, image.DefaultDecodeLimits)
}

test "committed WARP golden PNGs decode and match SHA-256" (sys: &System) {
    var ar := try Arena.New(sys.heap)
    defer ar.Free()
    Assert(GoldenWarpVersion.Len() > 0)
    g0 := try DecodeGoldenImage(&ar, 0)
    Assert(g0.width == 64 && g0.height == 64)
    ar.Reset()
    g1 := try DecodeGoldenImage(&ar, 1)
    Assert(g1.width == 64 && g1.height == 64)
    ar.Reset()
    g2 := try DecodeGoldenImage(&ar, 2)
    Assert(g2.width == 64 && g2.height == 64)
    ar.Reset()
    g3 := try DecodeGoldenImage(&ar, 3)
    Assert(g3.width == 64 && g3.height == 64)
    ar.Reset()
    g4 := try DecodeGoldenImage(&ar, 4)
    Assert(g4.width == 64 && g4.height == 64)
    ar.Reset()
    g5 := try DecodeGoldenImage(&ar, 5)
    Assert(g5.width == 64 && g5.height == 64)
    ar.Reset()
    g6 := try DecodeGoldenImage(&ar, 6)
    Assert(g6.width == 64 && g6.height == 64)
    ar.Reset()
    g7 := try DecodeGoldenImage(&ar, 7)
    Assert(g7.width == 64 && g7.height == 64)
    ar.Reset()
    g8 := try DecodeGoldenImage(&ar, 8)
    Assert(g8.width == 64 && g8.height == 64)
    ar.Reset()
}
