// Why: programs need an embedded SQL database; sqlite's C handles are easy
// to leak on an early return, and this build of sqlite is not safe across
// threads, so this module wraps it in linear handles, one process-wide
// lock and a Mk error set.
//
// What: std.db.sqlite: Open, Db (Prepare, Exec, Close), Stmt (BindInt,
// BindText, Step, Int, Str, Reset, Close) and the Error set (Sqlite, Busy,
// Misuse), over import c.sqlite3, which resolves only in a package that
// declares the sqlite3 CImport and a CSource (E0202 needs-cimport
// otherwise). The OS layer is vfs.mk and the C library is std.libc.
//
// How: Db and Stmt are linear, so a try cannot leak either. sqlite has no
// mutexes in this build (SQLITE_THREADSAFE=0), and that makes the whole
// library single-threaded, not one connection: sqlite3_initialize, the VFS
// list every open walks and the PRNG behind random() are unprotected
// globals. So every C call of this module, Open and Close included, runs
// under one process-wide lock (Big below), and &Db may be shared between
// tasks. A task that waits for the lock parks, so it holds no carrier; the
// holder keeps its carrier for the length of one C call. Parallel
// connections would need SQLITE_THREADSAFE=2 and a mutex written in Mk
// (sqlite3_mutex_methods); that waits for a measured need.
//
// Cancellation. Open, Prepare, Exec and Step take an Io: in a cancelled
// scope they fail Canceled before they start, and a task parked on the lock
// leaves with Canceled (cancellation is level-triggered). A statement that
// is running is not interrupted. The methods without an Io (the binds, the
// column reads, Reset, Close) wait through the Io their Db was opened with
// (or their Stmt prepared with) and are not cancelled.
//
// One process per database file. Connections of one process on one file
// exclude each other through the VFS's lock table and see Busy: names that
// differ only in "." components, repeated separators and, on Windows,
// separator style and ASCII case are one file, but a relative and an
// absolute spelling, a ".." and a link are not (vfs.mk). No other process
// is excluded until std.sys has file locks. A database that shrinks keeps
// its old size on disk (vfs.mk).
//
// Files. The VFS reads and writes through std.sys, on the carrier's system
// stack, never through the Io a call takes: an Io operation may suspend,
// which a function called from C cannot (the runtime's suspend-in-callback
// panic). So a Sim's Io reaches only the lock, never the database file.
//
// The package's CSource builds the amalgamation with -DSQLITE_OS_OTHER=1
// -DSQLITE_THREADSAFE=0 -DSQLITE_OMIT_LOCALTIME
// -DSQLITE_DEFAULT_MEMSTATUS=0 -DSQLITE_TEMP_STORE=3, and, for the
// Windows triple, -DSQLITE_WITHOUT_MSIZE -DSQLITE_DISABLE_INTRINSIC
// -DSQLITE_OMIT_SEH; -DSQLITE_MALLOCSIZE=malloc_usable_size saves
// sqlite's own size prefix in every allocation (std.libc). The C headers
// it includes are generated by the driver from std.libc.
//
// Errors: the primary code (code & 0xFF) 5 SQLITE_BUSY is Busy, 21 MISUSE
// Misuse, 7 NOMEM OutOfMemory, 9 INTERRUPT Canceled, and every other code,
// 6 SQLITE_LOCKED among them, is Sqlite with the extended code. LOCKED is a
// conflict inside one connection (a table dropped while one of its
// statements runs), which no wait clears, so it is not Busy.

import c.sqlite3
import std.raw
import std.sys

/// A sqlite failure, with sqlite's extended result code (sqlite3.h): a
/// second insert of a key in a unique column is Sqlite(code: 2067),
/// SQLITE_CONSTRAINT_UNIQUE. The low byte, code & 0xFF, is the primary
/// code (19, SQLITE_CONSTRAINT). Every code without a member of its own is
/// Sqlite, SQLITE_LOCKED (6) included: that is a conflict inside one
/// connection, such as a table dropped while one of its statements runs,
/// which waiting does not clear.
export error Sqlite(code: i32)
/// SQLITE_BUSY: another connection of this process holds a lock the call
/// needs. The call may be retried once that connection ends its
/// transaction.
export error Busy
/// SQLITE_MISUSE: the call broke sqlite's rules for its interface, or
/// Prepare was given no statement.
export error Misuse

/// Every failure of this module. SQLITE_NOMEM is OutOfMemory and
/// SQLITE_INTERRUPT is Canceled. The set is open, so a match on it outside
/// std keeps a `_` arm.
export open type Error = Sqlite | Busy | Misuse | OutOfMemory | Canceled

// h is sqlite's handle; io is Open's, which the methods that take no Io
// wait through.
/// An open connection to one database. It is linear: end it with Close.
/// A &Db may be shared between tasks. Every call of this module, on any
/// connection, takes one process-wide lock, so calls run one at a time.
export linear struct Db {
    h: *sqlite3.Sqlite3
    io: Io
}

// Big is the process-wide lock: std's Mutex, a queue lock in one word that
// spins briefly, then parks the waiter on the Io (WebKit's WordLock with
// Go's starvation bound, std/core/sync_mutex.mk), so a waiter burns no
// carrier while a long statement runs. Its acquire and release order every
// C call of one holder before the next holder's.
var Big: Mutex[u8] = Mutex[u8].New(0)

// io is Prepare's.
/// One prepared statement of a Db. It is linear: end it with Close. It
/// borrows the Db and Prepare's arena, so the Db cannot be closed while
/// the statement lives.
export linear view struct Stmt {
    s: *sqlite3.Sqlite3Stmt
    db: *Db
    io: Io
}

// Every C call on h is under Big, and the handle never moves.
unsafe impl Send for Db {}
unsafe impl Share for Db {}

// sqlite3_bind_text with the destructor as a plain pointer (*u8, which
// passes as C's pointer), so it can be SQLITE_TRANSIENT (-1), which the
// binding's fn-typed parameter cannot hold; an extern may name a C function
// the binding also declares.
extern sqlite3_bind_text(p0: *sqlite3.Sqlite3Stmt, p1: i32, p2: *u8, p3: i32, p4: *u8): i32

// Hold takes Big for a method that has no Io, through io without
// cancellation. The mask is taken here, so no scope's cancel reaches the
// lock, and its check goes on for a Sim run that crashed, was
// restarted or was freed, for a freed Recorder or Replayer, and for a
// Replayer that cannot replay it, so Close returns with such an Io. A
// NoCancel wait on a native Io never fails; a wait of a dead Sim run does,
// and then the carrier yields and tries again.
Hold(io: Io): Guard[u8] {
    nc := io.NoCancel()
    for {
        g := Big.Lock(nc) else {
            sys.ThreadYield()
            continue
        }
        return g
    }
}

// Fail maps a result code by its primary code, code & 0xFF (sqlite3.h).
Fail(code: i32): Error {
    return match code & 0xFF {
        5 { Busy }
        21 { Misuse }
        7 { OutOfMemory }
        9 { Canceled }
        _ { Sqlite(code: code) }
    }
}

// HasNul reports whether s holds a NUL byte, which C would read as its end.
HasNul(s: str): bool {
    for b in s.AsBytes() {
        if b == 0 {
            return true
        }
    }
    return false
}

/// Opens the database file at path for reading and writing, and creates it
/// when it is missing; "" or ":memory:" opens a database in memory. Fails
/// with Sqlite(14) (SQLITE_CANTOPEN) for a path that holds a NUL byte or
/// a file that cannot be opened, Canceled in a cancelled scope, and with
/// sqlite's code otherwise.
///
/// sqlite reads and writes the file through the OS, on the calling
/// thread, never through io: io serves cancellation and the wait for the
/// process-wide lock, so under a simulated Io the database file is still
/// a real file. Only connections of this process exclude each other;
/// another process is not locked out, so use a database file from one
/// process at a time. The path is copied with a NUL into a; sqlite
/// allocates the connection through std.libc.
export Open(a: &Arena, io: Io, path: str): Error!Db {
    if HasNul(path) {
        fail Sqlite(code: 14)
    }
    buf := try a.Slice[u8](path.Len() + 1)
    var h := raw.Null[sqlite3.Sqlite3]()
    var rc: i32 = 0
    g := try Big.Lock(io)
    unsafe "buf holds path and a NUL; h receives sqlite's handle; under Big" {
        raw.Copy(raw.DataMut(buf), raw.StrData(path), path.Len())
        rc = sqlite3.sqlite3_open_v2(raw.DataMut(buf), raw.OfMut(mut h), sqlite3.SqliteOpenReadwrite | sqlite3.SqliteOpenCreate, raw.Null[u8]())
        if rc != sqlite3.SqliteOk {
            if !raw.IsNull(h) {
                rc = sqlite3.sqlite3_extended_errcode(h)
                _ = sqlite3.sqlite3_close_v2(h)
            }
        }
    }
    g.Unlock()
    if rc != sqlite3.SqliteOk {
        fail Fail(rc)
    }
    return Db(h: h, io: io)
}

/// Compiles the first statement of sql. Fails with Misuse when sql holds
/// no statement, Sqlite(18) (SQLITE_TOOBIG) past 2^31 - 2 bytes, Canceled
/// in a cancelled scope, and with sqlite's code for a syntax or schema
/// error. O(len(sql)) to parse. a is reserved for the statement's own
/// copies; sqlite allocates the statement through std.libc.
export Db.Prepare(&self, a: &Arena, io: Io, sql: str): Error!Stmt from self, a {
    if sql.Len() > 0x7FFF_FFFE {
        fail Sqlite(code: 18)
    }
    g := try Big.Lock(io)
    var s := raw.Null[sqlite3.Sqlite3Stmt]()
    var rc: i32 = 0
    unsafe "self.h is open and under the lock; sql's bytes are read, not kept" {
        rc = sqlite3.sqlite3_prepare_v2(self.h, raw.StrData(sql), Trunc[i32](sql.Len()), raw.OfMut(mut s), raw.Null[*u8]())
        if rc != sqlite3.SqliteOk {
            rc = sqlite3.sqlite3_extended_errcode(self.h)
        }
    }
    g.Unlock()
    if rc != sqlite3.SqliteOk {
        fail Fail(rc)
    }
    if raw.IsNull(s) {
        // sql held no statement (only whitespace or comments).
        fail Misuse
    }
    return Stmt(s: s, db: raw.Of(self), io: io)
}

/// Runs every statement of sql, discarding rows. Fails as Prepare and Step
/// do, at the first statement that fails; the statements before it have
/// run. The process-wide lock is taken once per statement, so another task
/// may run between two. It allocates nothing in Mk.
export Db.Exec(&self, io: Io, sql: str): Error!void {
    if sql.Len() > 0x7FFF_FFFE {
        fail Sqlite(code: 18)
    }
    var off := 0
    for off < sql.Len() {
        g := try Big.Lock(io)
        var rc: i32 = 0
        unsafe "self.h is open and under the lock; the tail points into sql" {
            var s := raw.Null[sqlite3.Sqlite3Stmt]()
            var tail := raw.Null[u8]()
            p := raw.Offset(raw.StrData(sql), off)
            rc = sqlite3.sqlite3_prepare_v2(self.h, p, Trunc[i32](sql.Len() - off), raw.OfMut(mut s), raw.OfMut(mut tail))
            if rc == sqlite3.SqliteOk {
                if raw.IsNull(s) {
                    off = sql.Len()
                } else {
                    rc = sqlite3.sqlite3_step(s)
                    for rc == sqlite3.SqliteRow {
                        rc = sqlite3.sqlite3_step(s)
                    }
                    _ = sqlite3.sqlite3_finalize(s)
                    if rc == sqlite3.SqliteDone {
                        rc = sqlite3.SqliteOk
                    }
                    off = Trunc[int](raw.Addr(tail) - raw.Addr(raw.StrData(sql)))
                }
            }
            if rc != sqlite3.SqliteOk {
                rc = sqlite3.sqlite3_extended_errcode(self.h)
                if rc == sqlite3.SqliteOk {
                    rc = 1
                }
            }
        }
        g.Unlock()
        if rc != sqlite3.SqliteOk {
            fail Fail(rc)
        }
    }
}

/// Closes the connection, and rolls back a transaction it left open. It
/// cannot fail: no Stmt of the Db can still be open, since each borrows
/// it. It waits for the process-wide lock and is not cancelled.
export Db.Close(self) {
    g := Hold(self.io)
    unsafe "self.h is open and no Stmt is live; under Big" {
        _ = sqlite3.sqlite3_close_v2(self.h)
        raw.Forget(self)
    }
    g.Unlock()
}

// Code turns a call's result into the connection's extended code; the
// caller holds the lock.
Code(db: *Db, rc: i32): i32 {
    if rc == sqlite3.SqliteOk {
        return rc
    }
    unsafe "db is live by the Stmt's loan and its lock is held" {
        c := sqlite3.sqlite3_extended_errcode((*db).h)
        if c == sqlite3.SqliteOk {
            return rc
        }
        return c
    }
}

/// Binds parameter i (from 1, as ?1 in the SQL) to v. Fails with
/// Sqlite(25) (SQLITE_RANGE) for an i out of range. O(1). It waits for
/// the process-wide lock and is not cancelled.
export Stmt.BindInt(mut self, i: int, v: i64): Error!void {
    if i < 1 || i > 32766 {
        fail Sqlite(code: 25)
    }
    var rc: i32 = 0
    g := Hold(self.io)
    unsafe "st.db is live by the loan" {
        rc = Code(self.db, sqlite3.sqlite3_bind_int64(self.s, Trunc[i32](i), v))
    }
    g.Unlock()
    if rc != sqlite3.SqliteOk {
        fail Fail(rc)
    }
}

/// Binds parameter i (from 1) to a copy of s, so s need not outlive the
/// statement. Fails with Sqlite(25) for an i out of range and Sqlite(18)
/// past 2^31 - 2 bytes. O(len(s)); sqlite copies s through std.libc. It
/// waits for the process-wide lock and is not cancelled.
export Stmt.BindText(mut self, i: int, s: str): Error!void {
    if i < 1 || i > 32766 {
        fail Sqlite(code: 25)
    }
    if s.Len() > 0x7FFF_FFFE {
        fail Sqlite(code: 18)
    }
    var rc: i32 = 0
    g := Hold(self.io)
    unsafe "st.db is live by the loan; sqlite copies s before it returns" {
        rc = Code(self.db, sqlite3_bind_text(self.s, Trunc[i32](i), raw.StrData(s), Trunc[i32](s.Len()), raw.FromAddr[u8](0xFFFF_FFFF_FFFF_FFFF)))
    }
    g.Unlock()
    if rc != sqlite3.SqliteOk {
        fail Fail(rc)
    }
}

/// Runs the statement to its next row: true with a row, false when done.
/// Fails with Busy when another connection holds a lock it needs,
/// Canceled in a cancelled scope or while it waits for the process-wide
/// lock, and with sqlite's code otherwise. A statement that has started
/// runs to its next row; a cancel does not interrupt it.
export Stmt.Step(mut self, io: Io): Error!bool {
    var rc: i32 = 0
    g := try Big.Lock(io)
    unsafe "st.db is live by the loan" {
        rc = sqlite3.sqlite3_step(self.s)
        if rc != sqlite3.SqliteRow && rc != sqlite3.SqliteDone {
            rc = Code(self.db, rc)
        }
    }
    g.Unlock()
    if rc == sqlite3.SqliteRow {
        return true
    }
    if rc == sqlite3.SqliteDone {
        return false
    }
    fail Fail(rc)
}

/// Column col (from 0) of the current row as an integer, as sqlite
/// converts it; a NULL, a column past the end or no row gives 0. O(1).
export Stmt.Int(&self, col: int): i64 {
    if col < 0 || col > 32766 {
        return 0
    }
    var v: i64 = 0
    g := Hold(self.io)
    unsafe "self.db is live by the loan" {
        v = sqlite3.sqlite3_column_int64(self.s, Trunc[i32](col))
    }
    g.Unlock()
    return v
}

/// Column col (from 0) of the current row as text. The bytes are sqlite's
/// and stay valid until the next Step, Reset or Close; the compiler
/// enforces this, since the result borrows the Stmt; Step and Reset take
/// it mut and Close ends it. Copy the text into an arena to keep it
/// longer. A NULL, a column past the end, no row, or text that is not
/// UTF-8 gives "": Str has no error to report bad UTF-8 with, so read
/// such a column with SQL's length() or cast(x as blob). O(len).
export Stmt.Str(&self, col: int): str from self {
    if col < 0 || col > 32766 {
        return ""
    }
    var p := raw.Null[u8]()
    var n: i32 = 0
    g := Hold(self.io)
    unsafe "self.db is live by the loan" {
        p = sqlite3.sqlite3_column_text(self.s, Trunc[i32](col))
        n = sqlite3.sqlite3_column_bytes(self.s, Trunc[i32](col))
    }
    g.Unlock()
    if raw.IsNull(p) || n <= 0 {
        return ""
    }
    unsafe "p holds n bytes until the next Step, Reset or Close, all of which take self mut" {
        return str.From(raw.Slice(p, int(n))) else {
            return ""
        }
    }
}

/// Rewinds the statement to run again; the bindings stay. O(1). It cannot
/// fail.
export Stmt.Reset(mut self) {
    g := Hold(self.io)
    unsafe "self.db is live by the loan" {
        _ = sqlite3.sqlite3_reset(self.s)
    }
    g.Unlock()
}

/// Finalizes the statement and ends its loan on the Db. It cannot fail.
export Stmt.Close(self) {
    g := Hold(self.io)
    unsafe "self.db is live by the loan" {
        _ = sqlite3.sqlite3_finalize(self.s)
        raw.Forget(self)
    }
    g.Unlock()
}
