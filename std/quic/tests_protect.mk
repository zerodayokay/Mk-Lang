// Why: packet protection, header protection, Initial key derivation and
// Retry integrity tags must match RFC 9001 byte for byte or no QUIC peer
// can decrypt our packets.
//
// What: test blocks pinning RFC 9001 Appendix A.1-A.5, RFC 9001 5.4.2
// sampling and padding rules, key updates ("quic ku") and Retry tag checks.
//
// How: constructs each RFC vector in fixed stack arrays, verifies Protect,
// Unprotect, Seal, Open, InitialKeys, KeysFrom, NextKeys and RetryTag in
// both directions, and verifies negative cases (short sample, bad tag,
// wiped key).

import std.crypto

AssertBytesEq(got: []u8, want: []u8) {
    Assert(got.Len() == want.Len())
    for i in 0..got.Len() {
        Assert(got[i] == want[i])
    }
}

test "RFC 9001 A.1: client and server Initial key, iv and hp match the RFC vectors" (sys: &System) {
    dcid := CidFromSlice(b"\x83\x94\xc8\xf0\x3e\x51\x57\x08")
    ck := InitialKeys(&dcid, true)
    sk := InitialKeys(&dcid, false)

    // Client write keys == server read keys.
    want_c_iv: [12]u8 = [0xfa, 0x04, 0x4b, 0x2f, 0x42, 0xa3, 0xfd, 0x3b, 0x46, 0xfb, 0x25, 0x5c]
    want_s_iv: [12]u8 = [0x0a, 0xc1, 0x49, 0x3c, 0xa1, 0x90, 0x58, 0x53, 0xb0, 0xbb, 0xa0, 0x3e]
    AssertBytesEq(ck.write.iv[..], want_c_iv[..])
    AssertBytesEq(sk.read.iv[..], want_c_iv[..])
    AssertBytesEq(ck.read.iv[..], want_s_iv[..])
    AssertBytesEq(sk.write.iv[..], want_s_iv[..])

    // Verify derived client key and hp directly against RFC 9001 A.1 values.
    c_key: [16]u8 = [0x1f, 0x36, 0x96, 0x13, 0xdd, 0x76, 0xd5, 0x46, 0x77, 0x30, 0xef, 0xcb, 0xe3, 0xb1, 0xa2, 0x2d]
    c_hp: [16]u8 = [0x9f, 0x50, 0x44, 0x9e, 0x04, 0xa0, 0xe8, 0x10, 0x28, 0x3a, 0x1e, 0x99, 0x33, 0xad, 0xed, 0xd2]
    s_key: [16]u8 = [0xcf, 0x3a, 0x53, 0x31, 0x65, 0x3c, 0x36, 0x4c, 0x88, 0xf0, 0xf3, 0x79, 0xb6, 0x06, 0x7e, 0x37]
    s_hp: [16]u8 = [0xc2, 0x06, 0xb8, 0xd9, 0xb9, 0xf0, 0xf3, 0x76, 0x44, 0x43, 0x0b, 0x49, 0x0e, 0xea, 0xa3, 0x14]

    // Encrypt A.2 sample with expected client hp key and compare HpMask.
    a2_sample: [16]u8 = [0xd1, 0xb1, 0xc9, 0x8d, 0xd7, 0x68, 0x9f, 0xb8, 0xec, 0x11, 0xd2, 0x42, 0xb1, 0x23, 0xdc, 0x9b]
    want_a2_mask: [5]u8 = [0x43, 0x7b, 0x9a, 0xec, 0x36]
    got_a2_mask := HpMask(&ck.write.hp, &a2_sample)
    AssertBytesEq(got_a2_mask[..], want_a2_mask[..])

    aes_c := crypto.Aes.New(c_hp[..]).Must()
    blk_c := aes_c.Encrypt(&a2_sample).Must()
    AssertBytesEq(blk_c[0..5], want_a2_mask[..])

    // Encrypt A.3 sample with expected server hp key and compare HpMask.
    a3_sample: [16]u8 = [0x2c, 0xd0, 0x99, 0x1c, 0xd2, 0x5b, 0x0a, 0xac, 0x40, 0x6a, 0x58, 0x16, 0xb6, 0x39, 0x41, 0x00]
    want_a3_mask: [5]u8 = [0x2e, 0xc0, 0xd8, 0x35, 0x6a]
    got_a3_mask := HpMask(&sk.write.hp, &a3_sample)
    AssertBytesEq(got_a3_mask[..], want_a3_mask[..])

    aes_s := crypto.Aes.New(s_hp[..]).Must()
    blk_s := aes_s.Encrypt(&a3_sample).Must()
    AssertBytesEq(blk_s[0..5], want_a3_mask[..])

    // Verify AEAD keys match by sealing with raw AesGcm(c_key) and AesGcm(s_key).
    g_c := crypto.AesGcm.New(c_key[..]).Must()
    g_s := crypto.AesGcm.New(s_key[..]).Must()
    var tag1: [16]u8 = [0; 16]
    var tag2: [16]u8 = [0; 16]
    _ = g_c.Seal(&want_c_iv, b"aad", b"", mut tag1[..]).Must()
    Assert(Seal(&ck.write, 0, b"aad", b"", mut tag2[..]) == 16)
    AssertBytesEq(tag1[..], tag2[..])
    _ = g_s.Seal(&want_s_iv, b"aad", b"", mut tag1[..]).Must()
    Assert(Seal(&sk.write, 0, b"aad", b"", mut tag2[..]) == 16)
    AssertBytesEq(tag1[..], tag2[..])
}

test "RFC 9001 A.2: the client Initial packet protects to the RFC bytes" (sys: &System) {
    dcid := CidFromSlice(b"\x83\x94\xc8\xf0\x3e\x51\x57\x08")
    ck := InitialKeys(&dcid, true)
    sk := InitialKeys(&dcid, false)

    // RFC 9001 A.2 unprotected CRYPTO frame (245 bytes) padded to 1162 bytes.
    crypto_part: [245]u8 = [
        0x06, 0x00, 0x40, 0xf1, 0x01, 0x00, 0x00, 0xed, 0x03, 0x03, 0xeb, 0xf8, 0xfa, 0x56, 0xf1, 0x29,
        0x39, 0xb9, 0x58, 0x4a, 0x38, 0x96, 0x47, 0x2e, 0xc4, 0x0b, 0xb8, 0x63, 0xcf, 0xd3, 0xe8, 0x68,
        0x04, 0xfe, 0x3a, 0x47, 0xf0, 0x6a, 0x2b, 0x69, 0x48, 0x4c, 0x00, 0x00, 0x04, 0x13, 0x01, 0x13,
        0x02, 0x01, 0x00, 0x00, 0xc0, 0x00, 0x00, 0x00, 0x10, 0x00, 0x0e, 0x00, 0x00, 0x0b, 0x65, 0x78,
        0x61, 0x6d, 0x70, 0x6c, 0x65, 0x2e, 0x63, 0x6f, 0x6d, 0xff, 0x01, 0x00, 0x01, 0x00, 0x00, 0x0a,
        0x00, 0x08, 0x00, 0x06, 0x00, 0x1d, 0x00, 0x17, 0x00, 0x18, 0x00, 0x10, 0x00, 0x07, 0x00, 0x05,
        0x04, 0x61, 0x6c, 0x70, 0x6e, 0x00, 0x05, 0x00, 0x05, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x33,
        0x00, 0x26, 0x00, 0x24, 0x00, 0x1d, 0x00, 0x20, 0x93, 0x70, 0xb2, 0xc9, 0xca, 0xa4, 0x7f, 0xba,
        0xba, 0xf4, 0x55, 0x9f, 0xed, 0xba, 0x75, 0x3d, 0xe1, 0x71, 0xfa, 0x71, 0xf5, 0x0f, 0x1c, 0xe1,
        0x5d, 0x43, 0xe9, 0x94, 0xec, 0x74, 0xd7, 0x48, 0x00, 0x2b, 0x00, 0x03, 0x02, 0x03, 0x04, 0x00,
        0x0d, 0x00, 0x10, 0x00, 0x0e, 0x04, 0x03, 0x05, 0x03, 0x06, 0x03, 0x02, 0x03, 0x08, 0x04, 0x08,
        0x05, 0x08, 0x06, 0x00, 0x2d, 0x00, 0x02, 0x01, 0x01, 0x00, 0x1c, 0x00, 0x02, 0x40, 0x01, 0x00,
        0x39, 0x00, 0x32, 0x04, 0x08, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0x05, 0x04, 0x80,
        0x00, 0xff, 0xff, 0x07, 0x04, 0x80, 0x00, 0xff, 0xff, 0x08, 0x01, 0x10, 0x01, 0x04, 0x80, 0x00,
        0x75, 0x30, 0x09, 0x01, 0x10, 0x0f, 0x08, 0x83, 0x94, 0xc8, 0xf0, 0x3e, 0x51, 0x57, 0x08, 0x06,
        0x04, 0x80, 0x00, 0xff, 0xff,
    ]
    var plain: [1162]u8 = [0; 1162]
    (mut plain[0..245]).CopyFrom(crypto_part[..])

    // Unprotected header: c300000001088394c8f03e5157080000449e00000002 (22 bytes).
    // Note RFC A.2 uses 2-byte varint 0x449e for length 1182 and 4-byte PN 2.
    var pkt: [1200]u8 = [0; 1200]
    unprot_hdr: [22]u8 = [0xc3, 0x00, 0x00, 0x00, 0x01, 0x08, 0x83, 0x94, 0xc8, 0xf0, 0x3e, 0x51, 0x57, 0x08, 0x00,
        0x00, 0x44, 0x9e, 0x00, 0x00, 0x00, 0x02]
    (mut pkt[0..22]).CopyFrom(unprot_hdr[..])
    (left: h_s, right: b_s) := (mut pkt[..]).SplitAt(22)
    sn := Seal(&ck.write, 2, h_s[..], plain[..], b_s)
    Assert(sn == 1178)
    Protect(&ck.write, mut pkt[..], 18, 4)

    want_hdr: [22]u8 = [0xc0, 0x00, 0x00, 0x00, 0x01, 0x08, 0x83, 0x94, 0xc8, 0xf0, 0x3e, 0x51, 0x57, 0x08, 0x00,
        0x00, 0x44, 0x9e, 0x7b, 0x9a, 0xec, 0x34]
    AssertBytesEq(pkt[0..22], want_hdr[..])
    want_head_ct: [32]u8 = [0xd1, 0xb1, 0xc9, 0x8d, 0xd7, 0x68, 0x9f, 0xb8, 0xec, 0x11, 0xd2, 0x42, 0xb1, 0x23, 0xdc,
        0x9b, 0xd8, 0xba, 0xb9, 0x36, 0xb4, 0x7d, 0x92, 0xec, 0x35, 0x6c, 0x0b, 0xab, 0x7d, 0xf5, 0x97, 0x6d]
    AssertBytesEq(pkt[22..54], want_head_ct[..])
    want_tail_ct: [16]u8 = [0xe2, 0x21, 0xaf, 0x44, 0x86, 0x00, 0x18, 0xab, 0x08, 0x56, 0x97, 0x2e, 0x19, 0x4c, 0xd9,
        0x34]
    AssertBytesEq(pkt[1184..1200], want_tail_ct[..])

    // Server side parses, removes HP, decodes PN, opens AEAD and checks frames.
    var pn_off := 0
    match ParsePacket(pkt[..], 8).Must() {
        .Long(hdr, packet: _) {
            Assert(hdr.kind == PktInitial && hdr.pn_offset == 18 && hdr.length == 1182)
            pn_off = hdr.pn_offset
        }
        _ { Panic("expected Long") }
    }
    pn_len := Unprotect(&sk.read, mut pkt[..], pn_off).Must()
    Assert(pn_len == 4)
    pn := DecodePn(-1, ReadPn(pkt[..], pn_off, pn_len), pn_len * 8)
    Assert(pn == 2)
    CheckReservedBits(pkt[0], true).Must()
    var dec: [1162]u8 = [0; 1162]
    dn := Open(&sk.read, pn, pkt[0..pn_off + pn_len], pkt[pn_off + pn_len..1200], mut dec[..]).Must()
    Assert(dn == 1162)
    AssertBytesEq(dec[..], plain[..])
}

