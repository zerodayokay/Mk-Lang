test "RFC 9001 A.4: the Retry integrity tag matches the RFC vector" (sys: &System) {
    odcid := CidFromSlice(b"\x83\x94\xc8\xf0\x3e\x51\x57\x08")
    retry_pkt: [37]u8 = [
        0xff, 0x00, 0x00, 0x00, 0x01, 0x00, 0x08, 0xf0, 0x67, 0xa5, 0x50, 0x2a, 0x42, 0x62, 0xb5, 0x74,
        0x6f, 0x6b, 0x65, 0x6e, 0x04, 0xa2, 0x65, 0xba, 0x2e, 0xff, 0x4d, 0x82, 0x90, 0x58, 0xfb, 0x3f,
        0x0f, 0x24, 0x96, 0xba, 0x00,
    ]
    // Note RFC 9001 A.4 is 36 bytes: 20-byte body + 16-byte tag.
    full := retry_pkt[0..36]
    p := ParsePacket(full, 8).Must()
    match p {
        .Retry(version, dcid, scid, token, tag, packet: pkt) {
            Assert(version == Version1 && dcid.n == 0 && scid.n == 8 && token.Len() == 5)
            got := RetryTag(&odcid, pkt)
            AssertBytesEq(got[..], tag[..])
            Assert(VerifyRetryTag(&odcid, pkt, &tag))
        }
        _ { Panic("expected Retry") }
    }
}

test "RFC 9000 17.2.5.2: a Retry with a bad integrity tag is dropped" (sys: &System) {
    odcid := CidFromSlice(b"\x83\x94\xc8\xf0\x3e\x51\x57\x08")
    full: [36]u8 = [
        0xff, 0x00, 0x00, 0x00, 0x01, 0x00, 0x08, 0xf0, 0x67, 0xa5, 0x50, 0x2a, 0x42, 0x62, 0xb5, 0x74,
        0x6f, 0x6b, 0x65, 0x6e, 0x04, 0xa2, 0x65, 0xba, 0x2e, 0xff, 0x4d, 0x82, 0x90, 0x58, 0xfb, 0x3f,
        0x0f, 0x24, 0x96, 0xba,
    ]
    var bad_tag: [16]u8 = [0; 16]
    (mut bad_tag[..]).CopyFrom(full[20..36])
    bad_tag[0] = bad_tag[0] ^ 0x01
    Assert(!VerifyRetryTag(&odcid, full[0..20], &bad_tag))

    other_odcid := CidFromSlice(b"\x83\x94\xc8\xf0\x3e\x51\x57\x09")
    var good_tag: [16]u8 = [0; 16]
    (mut good_tag[..]).CopyFrom(full[20..36])
    Assert(!VerifyRetryTag(&other_odcid, full[0..20], &good_tag))
}

test "RFC 9001 A.5: the ChaCha20 short-header packet protects to the RFC bytes" (sys: &System) {
    var secret: [32]u8 = [
        0x9a, 0xc3, 0x12, 0xa7, 0xf8, 0x77, 0x46, 0x8e, 0xbe, 0x69, 0x42, 0x27, 0x48, 0xad, 0x00, 0xa1,
        0x54, 0x43, 0xf1, 0x82, 0x03, 0xa0, 0x7d, 0x60, 0x60, 0xf6, 0x88, 0xf3, 0x0f, 0x21, 0x63, 0x2b,
    ]
    k := KeysFrom(Suite.Chacha20Poly1305, secret[..]).Must()
    want_iv: [12]u8 = [0xe0, 0x45, 0x9b, 0x34, 0x74, 0xbd, 0xd0, 0xe4, 0x4a, 0x41, 0xc1, 0x44]
    AssertBytesEq(k.iv[..], want_iv[..])

    dcid := CidFromSlice(b"")
    var pkt: [21]u8 = [0; 21]
    h := WriteShortHeader(mut pkt[..], &dcid, false, 654360564, 3).Must()
    Assert(h.header_len == 4 && h.pn_offset == 1)
    want_unprot: [4]u8 = [0x42, 0x00, 0xbf, 0xf4]
    AssertBytesEq(pkt[0..4], want_unprot[..])

    plain: [1]u8 = [0x01]
    (left: h_s, right: b_s) := (mut pkt[..]).SplitAt(4)
    sn := Seal(&k, 654360564, h_s[..], plain[..], b_s)
    Assert(sn == 17)
    Protect(&k, mut pkt[..], h.pn_offset, 3)

    want_pkt: [21]u8 = [
        0x4c, 0xfe, 0x41, 0x89, 0x65, 0x5e, 0x5c, 0xd5, 0x5c, 0x41, 0xf6, 0x90, 0x80, 0x57, 0x5d, 0x79,
        0x99, 0xc2, 0x5a, 0x5b, 0xfb,
    ]
    AssertBytesEq(pkt[..], want_pkt[..])

    // Unprotect & open back.
    pn_len := Unprotect(&k, mut pkt[..], 1).Must()
    Assert(pn_len == 3)
    pn := DecodePn(654360000, ReadPn(pkt[..], 1, pn_len), pn_len * 8)
    Assert(pn == 654360564)
    CheckReservedBits(pkt[0], false).Must()
    var out: [1]u8 = [0; 1]
    dn := Open(&k, pn, pkt[0..4], pkt[4..21], mut out[..]).Must()
    Assert(dn == 1 && out[0] == 0x01)

    // Verify NextKeys ("quic ku") matches A.5's ku vector.
    _ = NextKeys(Suite.Chacha20Poly1305, mut secret[..]).Must()
    want_ku: [32]u8 = [
        0x12, 0x23, 0x50, 0x47, 0x55, 0x03, 0x6d, 0x55, 0x63, 0x42, 0xee, 0x93, 0x61, 0xd2, 0x53, 0x42,
        0x1a, 0x82, 0x6c, 0x9e, 0xcd, 0xf3, 0xc7, 0x14, 0x86, 0x84, 0xb3, 0x6b, 0x71, 0x48, 0x81, 0xf9,
    ]
    AssertBytesEq(secret[..], want_ku[..])
}

test "RFC 9001 5.4.2: the header protection sample starts 4 bytes after the packet number offset" (sys: &System) {
    var secret: [32]u8 = [0x22; 32]
    k := KeysFrom(Suite.Aes128Gcm, secret[..]).Must()
    dcid := CidFromSlice(b"\x10\x20\x30\x40\x50\x60\x70\x80")
    // 1-byte PN at pn_offset=9; sample must come from pkt[13..29].
    var pkt: [40]u8 = [0; 40]
    h := WriteShortHeader(mut pkt[..], &dcid, false, 5, 1).Must()
    Assert(h.pn_offset == 9 && h.header_len == 10)
    plain: [4]u8 = [0x01, 0x00, 0x00, 0x00]
    (left: h_s, right: b_s) := (mut pkt[..30]).SplitAt(10)
    sn := Seal(&k, 5, h_s[..], plain[..], b_s)
    Assert(sn == 20)
    var sample: [16]u8 = [0; 16]
    (mut sample[..]).CopyFrom(pkt[13..29])
    want_mask := HpMask(&k.hp, &sample)
    orig_b0 := pkt[0]
    orig_pn := pkt[9]
    Protect(&k, mut pkt[..30], h.pn_offset, 1)
    Assert(pkt[0] == (orig_b0 ^ (want_mask[0] & 0x1f)))
    Assert(pkt[9] == (orig_pn ^ want_mask[1]))
}

test "RFC 9001 5.4.2: a packet too short for a full header protection sample is dropped" (sys: &System) {
    var secret: [32]u8 = [0x33; 32]
    var k := KeysFrom(Suite.Aes128Gcm, secret[..]).Must()
    var buf: [28]u8 = [0; 28]
    buf[0] = 0x40
    // pn_offset = 9 needs at least 29 bytes (9 + 4 + 16).
    AssertNone(Unprotect(&k, mut buf[..], 9))
    AssertNone(ParsePacket(buf[..], 8))

    // And AES-256-GCM round trip + Wipe behaviour.
    var s48: [48]u8 = [0x44; 48]
    var k256 := KeysFrom(Suite.Aes256Gcm, s48[..]).Must()
    dcid := CidFromSlice(b"\x01\x02\x03\x04\x05\x06\x07\x08")
    var pkt: [40]u8 = [0; 40]
    h := WriteShortHeader(mut pkt[..], &dcid, true, 7, 1).Must()
    plain: [4]u8 = [0x01, 0x00, 0x00, 0x00]
    (left: h_s, right: b_s) := (mut pkt[..30]).SplitAt(h.header_len)
    _ = Seal(&k256, 7, h_s[..], plain[..], b_s)
    Protect(&k256, mut pkt[..30], h.pn_offset, 1)
    pn_len := Unprotect(&k256, mut pkt[..30], h.pn_offset).Must()
    Assert(pn_len == 1 && (pkt[0] & 0x04) != 0)
    var out: [4]u8 = [0; 4]
    Assert(Open(&k256, 7, pkt[0..h.header_len], pkt[h.header_len..30], mut out[..]).Must() == 4)
    k256.Wipe()
    k.Wipe()
    var got_wiped_err := false
    _ = Open(&k256, 7, pkt[0..h.header_len], pkt[h.header_len..30], mut out[..]) else {
        got_wiped_err = true
        0
    }
    Assert(got_wiped_err)
}

test "RFC 9001 5.4.2: a packet whose frames are shorter than the sample needs is padded so the sample fits" (sys: &System) {
    Assert(MinSamplePadding(1, 1) == 2)
    Assert(MinSamplePadding(1, 2) == 1)
    Assert(MinSamplePadding(1, 3) == 0)
    Assert(MinSamplePadding(2, 1) == 1)
    Assert(MinSamplePadding(2, 2) == 0)
    Assert(MinSamplePadding(3, 1) == 0)
    Assert(MinSamplePadding(4, 1) == 0)
}
