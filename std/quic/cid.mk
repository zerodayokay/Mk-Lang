// Why: QUIC connections manage both local connection IDs (issued to the peer,
// registered in the endpoint demux, with HMAC-derived stateless reset tokens)
// and peer connection IDs (used as DCIDs, rotated on Retire Prior To, and
// checked for stateless reset tokens in constant time).
//
// What: CidState, MakeStatelessResetToken, RandomLocalCid, and CID frame
// issuance/retirement helpers.
//
// How: RFC 9000 sections 5.1, 10.3, 18.2, 19.15, and 19.16. All local CIDs
// are 8 bytes; our active_connection_id_limit is 4 with up to 8 pending
// retirements; at most 64 local CIDs are issued over a connection's life;
// reset token comparison uses crypto.Equal over used, unretired peer CIDs.

import std.crypto

// Fixed length of every connection ID generated by this endpoint (Section 3.6.7).
const LocalCidLen: int = 8

// Our advertised active_connection_id_limit (RFC 9000 18.2).
const OurActiveCidLimit: u64 = 4

// Twice our active_connection_id_limit: cap on pending RETIRE_CONNECTION_IDs (5.1.2).
const MaxPendingRetires: int = 8

// Maximum local CIDs issued over one connection's lifetime (Section 3.11).
const MaxIssuedCids: int = 64

// Generates an 8-byte unpredictable connection ID using crypto.Random.
RandomLocalCid(io: Io): Canceled!Cid {
    var b: [MaxCidLen]u8 = [0; MaxCidLen]
    try crypto.Random(io, mut b[0..LocalCidLen])
    return Cid(b: b, n: LocalCidLen)
}

// Derives a 16-byte stateless reset token from static_key and cid via
// HMAC-SHA256 truncated to 16 bytes (RFC 9000 10.3.2). O(1).
MakeStatelessResetToken(static_key: &[32]u8, cid: &Cid): [16]u8 {
    mac := crypto.Hmac256(static_key[..], CidBytes(cid))
    var out: [16]u8 = [0; 16]
    (mut out[..]).CopyFrom(mac[0..16])
    return out
}

// One local connection ID issued by this endpoint.
struct LocalCid {
    seq: u64
    cid: Cid
    token: [16]u8
    retired: bool
    pending_send: bool
}

// One peer connection ID received via handshake, preferred_address, or NEW_CONNECTION_ID.
struct PeerCid {
    seq: u64
    cid: Cid
    token: [16]u8
    has_token: bool
    used: bool
    retired: bool
}

// Per-connection local and peer connection ID state.
// Linear: owns HeapLists on &Alloc.
linear struct CidState {
    client: bool
    local: HeapList[LocalCid]
    local_next_seq: u64
    local_total_issued: int
    peer_active_limit: u64
    static_key: [32]u8
    has_static_key: bool
    peer: HeapList[PeerCid]
    current_peer_idx: int
    retire_prior: u64
    pending_retires: HeapList[u64]
    peer_zero_len: bool
    hs_complete: bool
}

// Initializes CidState with the initial peer CID (for client: its initial DCID;
// for server: client's SCID) and optionally our initial local CID seq 0. O(1).
CidState.New(a: &Alloc, client: bool, first_peer: &Cid): OutOfMemory!CidState from a {
    var peer := HeapList[PeerCid].New(a)
    onerr peer.Free(a)
    try peer.Push(a, PeerCid(
        seq: 0,
        cid: *first_peer,
        token: [0; 16],
        has_token: false,
        used: true,
        retired: false,
    ))
    return CidState(
        client: client,
        local: HeapList[LocalCid].New(a),
        local_next_seq: 0,
        local_total_issued: 0,
        peer_active_limit: DefaultActiveCidLimit,
        static_key: [0; 32],
        has_static_key: false,
        peer: peer,
        current_peer_idx: 0,
        retire_prior: 0,
        pending_retires: HeapList[u64].New(a),
        peer_zero_len: first_peer.n == 0,
        hs_complete: false,
    )
}

// Releases CidState buffers back to a and wipes static_key. O(1).
CidState.Free(self, a: &Alloc) {
    CidState(
        client: _,
        local,
        local_next_seq: _,
        local_total_issued: _,
        peer_active_limit: _,
        static_key,
        has_static_key: _,
        peer,
        current_peer_idx: _,
        retire_prior: _,
        pending_retires,
        peer_zero_len: _,
        hs_complete: _,
    ) := self
    var sk := static_key
    crypto.Wipe(mut sk[..])
    local.Free(a)
    peer.Free(a)
    pending_retires.Free(a)
}

// Sets the endpoint static key for stateless reset token derivation.
CidState.SetStaticKey(mut self, key: &[32]u8) {
    self.static_key = *key
    self.has_static_key = true
}

// Records our initial handshake SCID at sequence number 0.
CidState.AddLocalInitial(mut self, a: &Alloc, scid: &Cid): OutOfMemory!void {
    tok := if self.has_static_key { MakeStatelessResetToken(&self.static_key, scid) } else { [0; 16] }
    try self.local.Push(a, LocalCid(
        seq: 0,
        cid: *scid,
        token: tok,
        retired: false,
        pending_send: false,
    ))
    self.local_next_seq = 1
    self.local_total_issued = 1
}

// Sets peer's initial handshake CID (e.g. when client switches DCID on Retry or
// server's first Initial).
CidState.SetPeerHandshakeCid(mut self, cid: &Cid) {
    items := self.peer.ItemsMut()
    items[0].cid = *cid
    items[0].used = true
    self.peer_zero_len = cid.n == 0
}

// Installs authenticated peer transport parameters once the handshake completes.
// Saves the active limit, sequence 0 reset token, and sequence 1 preferred
// address CID. The latter counts toward the limit and is never used.
CidState.OnHandshakeAuthed(mut self, a: &Alloc, p: &Params): Error!void {
    self.hs_complete = true
    self.peer_active_limit = p.active_connection_id_limit
    if tok := p.stateless_reset_token {
        items := self.peer.ItemsMut()
        items[0].token = tok
        items[0].has_token = true
    }
    if pa := p.preferred_address {
        if self.peer_zero_len {
            fail TransportError(code: ErrProtocolViolation, frame: 0)
        }
        try self.OnNewCid(a, 1, 0, &pa.cid, &pa.reset_token)
    }
}

// Returns the count of currently active (unretired) local CIDs. O(local.Len()).
CidState.ActiveLocalCount(&self): int {
    var c := 0
    items := self.local.Items()
    for i in 0..items.Len() {
        if !items[i].retired {
            c += 1
        }
    }
    return c
}

// Returns true if cid matches any previously issued local CID on this connection
// (never issue the same CID twice on one connection).
CidState.HasLocalCid(&self, cid: &Cid): bool {
    items := self.local.Items()
    for i in 0..items.Len() {
        if CidEqual(&items[i].cid, cid) {
            return true
        }
    }
    return false
}

// Issues a new local CID if below min(peer_active_limit, OurActiveCidLimit) and
// total issued < MaxIssuedCids. Returns the issued LocalCid or none.
CidState.IssueLocal(mut self, a: &Alloc, new_cid: &Cid): OutOfMemory!?LocalCid {
    cap_lim := if self.peer_active_limit < OurActiveCidLimit { Cast[int](self.peer_active_limit) } else { Cast[int](OurActiveCidLimit) }
    if self.ActiveLocalCount() >= cap_lim || self.local_total_issued >= MaxIssuedCids {
        return none
    }
    if self.HasLocalCid(new_cid) {
        return none
    }
    seq := self.local_next_seq
    tok := if self.has_static_key { MakeStatelessResetToken(&self.static_key, new_cid) } else { [0; 16] }
    entry := LocalCid(seq: seq, cid: *new_cid, token: tok, retired: false, pending_send: true)
    try self.local.Push(a, entry)
    self.local_next_seq += 1
    self.local_total_issued += 1
    return some(entry)
}

// Returns the next pending NEW_CONNECTION_ID to send and marks it sent, or none.
CidState.TakePendingNewCid(mut self): ?(seq: u64, retire_prior: u64, cid: Cid, token: [16]u8) {
    items := self.local.ItemsMut()
    for i in 0..items.Len() {
        if items[i].pending_send && !items[i].retired {
            items[i].pending_send = false
            return some((seq: items[i].seq, retire_prior: 0, cid: items[i].cid, token: items[i].token))
        }
    }
    return none
}

// Re-queues a lost NEW_CONNECTION_ID frame for seq if still unretired (RFC 9000 13.3).
CidState.OnNewCidLost(mut self, seq: u64) {
    items := self.local.ItemsMut()
    for i in 0..items.Len() {
        if items[i].seq == seq && !items[i].retired {
            items[i].pending_send = true
            return
        }
    }
}

// Handles a received RETIRE_CONNECTION_ID(seq) frame (RFC 9000 5.1.2, 19.16).
// pkt_dcid is the DCID of the packet that carried the frame.
// Returns the retired local Cid if newly retired (so the endpoint removes it).
CidState.OnRetire(mut self, seq: u64, pkt_dcid: &Cid): Error!?Cid {
    if seq >= self.local_next_seq {
        fail TransportError(code: ErrProtocolViolation, frame: FrameRetireConnectionId)
    }
    items := self.local.ItemsMut()
    for i in 0..items.Len() {
        if items[i].seq == seq {
            if CidEqual(&items[i].cid, pkt_dcid) {
                fail TransportError(code: ErrProtocolViolation, frame: FrameRetireConnectionId)
            }
            if items[i].retired {
                return none
            }
            items[i].retired = true
            items[i].pending_send = false
            return some(items[i].cid)
        }
    }
    return none
}

// Returns the count of currently active (unretired) peer CIDs. O(peer.Len()).
CidState.ActivePeerCount(&self): int {
    var c := 0
    items := self.peer.Items()
    for i in 0..items.Len() {
        if !items[i].retired {
            c += 1
        }
    }
    return c
}

// Queues a RETIRE_CONNECTION_ID(seq) if not already queued, enforcing the 2x
// active_connection_id_limit pending cap.
CidState.QueueRetire(mut self, a: &Alloc, seq: u64): Error!void {
    q := self.pending_retires.Items()
    for i in 0..q.Len() {
        if q[i] == seq {
            return
        }
    }
    if self.pending_retires.Len() >= MaxPendingRetires {
        fail TransportError(code: ErrConnectionIdLimit, frame: FrameNewConnectionId)
    }
    try self.pending_retires.Push(a, seq)
}

// Selects an unretired peer CID index, preferring one different from avoid_seq.
CidState.PickSurvivingPeerIdx(&self, avoid_seq: u64): int {
    items := self.peer.Items()
    for i in 0..items.Len() {
        if !items[i].retired && items[i].seq != avoid_seq {
            return i
        }
    }
    return -1
}

// Processes a NEW_CONNECTION_ID frame (RFC 9000 5.1.1, 5.1.2, 19.15). O(peer.Len()).
CidState.OnNewCid(mut self, a: &Alloc, seq: u64, retire_prior: u64, cid: &Cid, token: &[16]u8): Error!void {
    if self.peer_zero_len {
        fail TransportError(code: ErrProtocolViolation, frame: FrameNewConnectionId)
    }
    if cid.n < 1 || cid.n > MaxCidLen {
        fail TransportError(code: ErrFrameEncoding, frame: FrameNewConnectionId)
    }
    if retire_prior > seq {
        fail TransportError(code: ErrFrameEncoding, frame: FrameNewConnectionId)
    }

    // Check duplicate seq.
    items := self.peer.Items()
    for i in 0..items.Len() {
        if items[i].seq == seq {
            if CidEqual(&items[i].cid, cid) && crypto.Equal(items[i].token[..], token[..]) {
                return
            }
            fail TransportError(code: ErrProtocolViolation, frame: FrameNewConnectionId)
        }
    }

    // Apply Retire Prior To if it advances.
    if retire_prior > self.retire_prior {
        self.retire_prior = retire_prior
        // Switch away from any retired current peer CID first.
        cur_seq := self.peer[self.current_peer_idx].seq
        if cur_seq < retire_prior {
            // Try surviving existing CIDs first.
            var found := -1
            pitems := self.peer.Items()
            for i in 0..pitems.Len() {
                if !pitems[i].retired && pitems[i].seq >= retire_prior {
                    found = i
                    break
                }
            }
            if found >= 0 {
                self.current_peer_idx = found
                pitems_m := self.peer.ItemsMut()
                pitems_m[found].used = true
            }
        }
        var idx := 0
        for idx < self.peer.Len() {
            if !self.peer[idx].retired && self.peer[idx].seq < retire_prior {
                pseq := self.peer[idx].seq
                pitems_m := self.peer.ItemsMut()
                pitems_m[idx].retired = true
                try self.QueueRetire(a, pseq)
            }
            idx += 1
        }
    }

    // Sequence below largest Retire Prior To: retire at once without counting.
    if seq < self.retire_prior {
        try self.QueueRetire(a, seq)
        return
    }

    // Insert the new peer CID.
    need_switch := self.peer[self.current_peer_idx].retired
    try self.peer.Push(a, PeerCid(
        seq: seq,
        cid: *cid,
        token: *token,
        has_token: true,
        used: need_switch,
        retired: false,
    ))
    if need_switch {
        self.current_peer_idx = self.peer.Len() - 1
    }

    // Enforce active_connection_id_limit AFTER retire_prior.
    if Cast[u64](self.ActivePeerCount()) > OurActiveCidLimit {
        fail TransportError(code: ErrConnectionIdLimit, frame: FrameNewConnectionId)
    }
}

// Pops the next pending RETIRE_CONNECTION_ID sequence number to send, ensuring
// we never retire the current DCID used to carry the frame.
CidState.TakePendingRetire(mut self): ?u64 {
    if self.peer_zero_len || self.pending_retires.Len() == 0 {
        return none
    }
    cur_seq := self.peer[self.current_peer_idx].seq
    q := self.pending_retires.Items()
    for i in 0..q.Len() {
        if q[i] != cur_seq {
            return some(self.pending_retires.Remove(i))
        }
    }
    // Only pending retire equals current_peer_idx: switch to an unretired peer CID first.
    alt := self.PickSurvivingPeerIdx(cur_seq)
    if alt >= 0 {
        self.current_peer_idx = alt
        pitems := self.peer.ItemsMut()
        pitems[alt].used = true
        for i in 0..self.pending_retires.Len() {
            if self.pending_retires[i] != self.peer[self.current_peer_idx].seq {
                return some(self.pending_retires.Remove(i))
            }
        }
    }
    return none
}

// Re-queues a lost RETIRE_CONNECTION_ID frame (RFC 9000 13.3).
CidState.OnRetireLost(mut self, a: &Alloc, seq: u64) {
    _ = self.QueueRetire(a, seq) else {}
}

// Returns the current peer DCID to send packets to. O(1).
CidState.Current(&self): &Cid from self {
    return &self.peer[self.current_peer_idx].cid
}

// Returns a spare unused/unretired peer CID (for old-path PATH_CHALLENGE),
// or falls back to the current peer CID if none is spare. O(peer.Len()).
CidState.SparePeerCid(&self): &Cid from self {
    items := self.peer.Items()
    for i in 0..items.Len() {
        if !items[i].retired && i != self.current_peer_idx && items[i].seq != 1 {
            return &items[i].cid
        }
    }
    return &items[self.current_peer_idx].cid
}

// Checks in constant time whether tail (16 bytes) matches the stateless reset
// token of any used, unretired peer CID after handshake authentication
// (RFC 9000 10.3.1). O(peer.Len()).
CidState.IsResetToken(&self, tail: &[16]u8): bool {
    if !self.hs_complete {
        return false
    }
    var matched := false
    items := self.peer.Items()
    for i in 0..items.Len() {
        if items[i].used && !items[i].retired && items[i].has_token {
            if crypto.Equal(items[i].token[..], tail[..]) {
                matched = true
            }
        }
    }
    return matched
}
