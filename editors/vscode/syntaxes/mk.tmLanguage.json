{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Mk",
  "scopeName": "source.mk",
  "comment": "Go-style highlighting for Mk. The word lists follow the lexical rules of doc/reference.md and the compiler's keyword table; test/grammar.test.js checks every word against both. The semantic tokens of mk lsp refine names on top of this.",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#method-declaration"
    },
    {
      "include": "#function-declaration"
    },
    {
      "include": "#type-declaration"
    },
    {
      "include": "#statements"
    }
  ],
  "repository": {
    "statements": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#chars"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#splice"
        },
        {
          "include": "#asm"
        },
        {
          "include": "#ensures"
        },
        {
          "include": "#type-declaration"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#builtins"
        },
        {
          "include": "#type-annotation"
        },
        {
          "include": "#error-union"
        },
        {
          "include": "#calls"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.mk",
          "begin": "///",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.mk"
            }
          },
          "end": "$",
          "patterns": [
            {
              "include": "#comment-code"
            }
          ]
        },
        {
          "name": "comment.line.double-slash.mk",
          "begin": "//",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.mk"
            }
          },
          "end": "$",
          "patterns": [
            {
              "include": "#comment-code"
            },
            {
              "comment": "Conformance markers: // <- E0501, and a block's // verdict: line.",
              "match": "(<-)\\s*(E\\d{4})",
              "captures": {
                "1": {
                  "name": "keyword.operator.marker.mk"
                },
                "2": {
                  "name": "constant.other.error-code.mk"
                }
              }
            }
          ]
        }
      ]
    },
    "comment-code": {
      "match": "`[^`]*`",
      "name": "markup.inline.raw.mk"
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.mk",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.mk"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.mk"
            }
          },
          "patterns": [
            {
              "include": "#escapes"
            },
            {
              "include": "#placeholders"
            }
          ]
        },
        {
          "name": "string.quoted.raw.mk",
          "begin": "\\b(r)(\")",
          "end": "\"",
          "beginCaptures": {
            "1": {
              "name": "storage.type.string.mk"
            },
            "2": {
              "name": "punctuation.definition.string.begin.mk"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.mk"
            }
          }
        },
        {
          "name": "string.quoted.double.mk",
          "begin": "(?:\\b(b))?(\")",
          "end": "\"",
          "beginCaptures": {
            "1": {
              "name": "storage.type.string.mk"
            },
            "2": {
              "name": "punctuation.definition.string.begin.mk"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.mk"
            }
          },
          "patterns": [
            {
              "include": "#escapes"
            },
            {
              "include": "#placeholders"
            }
          ]
        }
      ]
    },
    "escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.mk",
          "match": "\\\\(?:u\\{[0-9A-Fa-f]+\\}|x[0-9A-Fa-f]{2}|.)"
        }
      ]
    },
    "placeholders": {
      "comment": "Format holes of Print and Fmt: {name}, {name:spec}; {{ and }} are literal braces.",
      "patterns": [
        {
          "name": "constant.character.escape.mk",
          "match": "\\{\\{|\\}\\}"
        },
        {
          "name": "constant.other.placeholder.mk",
          "match": "\\{[A-Za-z_][A-Za-z0-9_.]*(?::[^{}\"]*)?\\}"
        }
      ]
    },
    "chars": {
      "name": "string.quoted.single.mk",
      "match": "(?:\\b(b))?(')(\\\\(?:u\\{[0-9A-Fa-f]+\\}|x[0-9A-Fa-f]{2}|.)|[^'\\\\])(')",
      "captures": {
        "1": {
          "name": "storage.type.string.mk"
        },
        "2": {
          "name": "punctuation.definition.string.begin.mk"
        },
        "3": {
          "patterns": [
            {
              "include": "#escapes"
            }
          ]
        },
        "4": {
          "name": "punctuation.definition.string.end.mk"
        }
      }
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.mk",
          "match": "\\b0x[0-9A-Fa-f_]+\\b"
        },
        {
          "name": "constant.numeric.octal.mk",
          "match": "\\b0o[0-7_]+\\b"
        },
        {
          "name": "constant.numeric.binary.mk",
          "match": "\\b0b[01_]+\\b"
        },
        {
          "name": "constant.numeric.float.mk",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*(?:[eE][+-]?[0-9_]+)?\\b"
        },
        {
          "name": "constant.numeric.float.mk",
          "match": "\\b[0-9][0-9_]*[eE][+-]?[0-9_]+\\b"
        },
        {
          "name": "constant.numeric.integer.mk",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "splice": {
      "comment": "Inside quote { }: $name and $(expr) splice values into the emitted code.",
      "patterns": [
        {
          "name": "variable.other.splice.mk",
          "match": "\\$[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "name": "keyword.operator.splice.mk",
          "match": "\\$(?=\\()"
        }
      ]
    },
    "asm": {
      "comment": "asm(\"template\", operands): the operand and option words are keywords only inside the parentheses.",
      "begin": "\\b(asm)\\s*(\\()",
      "beginCaptures": {
        "1": {
          "name": "storage.modifier.unsafe.mk"
        },
        "2": {
          "name": "punctuation.parenthesis.begin.mk"
        }
      },
      "end": "\\)",
      "endCaptures": {
        "0": {
          "name": "punctuation.parenthesis.end.mk"
        }
      },
      "patterns": [
        {
          "include": "#asm-parens"
        },
        {
          "include": "#asm-words"
        },
        {
          "include": "#statements"
        }
      ]
    },
    "asm-parens": {
      "begin": "\\(",
      "end": "\\)",
      "patterns": [
        {
          "include": "#asm-parens"
        },
        {
          "include": "#asm-words"
        },
        {
          "include": "#statements"
        }
      ]
    },
    "asm-words": {
      "name": "keyword.other.asm.mk",
      "match": "\\b(?:in|out|inout|lateout|inlateout|const|sym|options|clobber_abi|att|raw|nomem|nostack|preserves_flags|pure|readonly|noreturn|reg|reg_byte|kreg|xmm_reg|ymm_reg|zmm_reg)\\b"
    },
    "ensures": {
      "comment": "ensures: result names the function's result up to the end of the clause.",
      "begin": "\\b(ensures)\\b",
      "beginCaptures": {
        "1": {
          "name": "keyword.other.contract.mk"
        }
      },
      "end": "(?=\\{)|$",
      "patterns": [
        {
          "name": "variable.language.result.mk",
          "match": "\\bresult\\b"
        },
        {
          "include": "#statements"
        }
      ]
    },
    "method-declaration": {
      "comment": "A method at the top level: [export] [unsafe] Type[params].Name(",
      "match": "^(?:(export)\\s+)?(?:(unsafe)\\s+)?(?:(naked)\\s+)?(?!(?:import|export|struct|enum|error|interface|impl|type|const|var|linear|view|gen|quote|test|extern|if|else|for|in|match|return|break|continue|defer|onerr|fail|try|scope|go|unsafe|asm|become|mut|fn|is|requires|ensures|invariant|packed|align)\\b)([A-Za-z_][A-Za-z0-9_]*)(\\[[^\\]]*\\])?(\\.)([A-Za-z_][A-Za-z0-9_]*)(?=\\s*[\\[(])",
      "captures": {
        "1": {
          "name": "storage.modifier.export.mk"
        },
        "2": {
          "name": "storage.modifier.unsafe.mk"
        },
        "3": {
          "name": "storage.modifier.mk"
        },
        "4": {
          "name": "entity.name.type.mk"
        },
        "5": {
          "patterns": [
            {
              "include": "#type-parameters"
            }
          ]
        },
        "6": {
          "name": "punctuation.accessor.mk"
        },
        "7": {
          "name": "entity.name.function.mk"
        }
      }
    },
    "function-declaration": {
      "comment": "A function at the top level, with no keyword: [export] [unsafe] [naked] [extern [\"abi\"]] [naked] Name[params](",
      "match": "^(?:(export)\\s+)?(?:(unsafe)\\s+)?(?:(naked)\\s+)?(?:(extern)\\s+(?:(\"[^\"]*\")\\s+)?)?(?:(naked)\\s+)?(?!(?:import|export|struct|enum|error|interface|impl|type|const|var|linear|view|gen|quote|test|extern|if|else|for|in|match|return|break|continue|defer|onerr|fail|try|scope|go|unsafe|asm|become|mut|fn|is|requires|ensures|invariant|packed|align)\\b)([A-Za-z_][A-Za-z0-9_]*)(?=\\s*[\\[(])",
      "captures": {
        "1": {
          "name": "storage.modifier.export.mk"
        },
        "2": {
          "name": "storage.modifier.unsafe.mk"
        },
        "3": {
          "name": "storage.modifier.mk"
        },
        "4": {
          "name": "storage.type.extern.mk"
        },
        "5": {
          "name": "string.quoted.double.mk"
        },
        "6": {
          "name": "storage.modifier.mk"
        },
        "7": {
          "name": "entity.name.function.mk"
        }
      }
    },
    "type-declaration": {
      "comment": "struct S, enum E, error E, interface I, type T, and the modifiers before them (export, open, unsafe, linear, mut view, plain view, view, packed, align).",
      "match": "\\b(?:(export)\\s+)?(?:(open)\\s+)?(?:(unsafe)\\s+)?(?:(linear)\\s+)?(?:(?:(mut|plain)\\s+)?(view)\\s+)?(?:(packed)(?:\\([0-9]+\\))?\\s+)?(?:(align)\\([0-9_]+\\)\\s+)?(struct|enum|error|interface|type)\\s+([A-Za-z_][A-Za-z0-9_]*)(\\[[^\\]]*\\])?",
      "captures": {
        "1": {
          "name": "storage.modifier.export.mk"
        },
        "2": {
          "name": "storage.modifier.mk"
        },
        "3": {
          "name": "storage.modifier.unsafe.mk"
        },
        "4": {
          "name": "storage.modifier.mk"
        },
        "5": {
          "name": "storage.modifier.mk"
        },
        "6": {
          "name": "storage.modifier.mk"
        },
        "7": {
          "name": "storage.modifier.mk"
        },
        "8": {
          "name": "storage.modifier.mk"
        },
        "9": {
          "name": "storage.type.$9.mk"
        },
        "10": {
          "name": "entity.name.type.mk"
        },
        "11": {
          "patterns": [
            {
              "include": "#type-parameters"
            }
          ]
        }
      }
    },
    "type-parameters": {
      "patterns": [
        {
          "match": "(?<=[\\[,])\\s*(const\\s+)?([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.const.mk"
            },
            "2": {
              "name": "entity.name.type.parameter.mk"
            }
          }
        },
        {
          "include": "#statements"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.mk",
          "match": "\\b(?:if|else|for|in|match|return|become|break|continue|defer|onerr|fail|try|scope|go)\\b"
        },
        {
          "name": "keyword.other.import.mk",
          "match": "\\bimport\\b"
        },
        {
          "name": "storage.modifier.export.mk",
          "match": "\\bexport\\b"
        },
        {
          "name": "storage.type.mk",
          "match": "\\b(?:struct|enum|error|interface|impl|type|const|var|fn|gen|quote|test|extern)\\b"
        },
        {
          "name": "storage.modifier.unsafe.mk",
          "match": "\\b(?:unsafe|asm)\\b"
        },
        {
          "name": "storage.modifier.mk",
          "match": "\\b(?:linear|view|mut)\\b"
        },
        {
          "name": "keyword.other.contract.mk",
          "match": "\\b(?:requires|ensures|invariant|is)\\b"
        },
        {
          "comment": "Contextual: the flow words of a signature, not when used as a name.",
          "name": "keyword.other.flow.mk",
          "match": "\\b(?:from|into|ends)\\b(?!\\s*(?::=|=[^=]|:|\\.|\\())"
        },
        {
          "comment": "Contextual words that are keywords only in their positions: packed, plain, align, cpu, section, naked, open, fuel.",
          "patterns": [
            {
              "name": "storage.modifier.mk",
              "match": "\\b(?:packed|align)\\b(?=\\s*\\()|\\bpacked\\b(?=\\s+(?:struct|align|plain|linear|view|mut)\\b)"
            },
            {
              "name": "storage.modifier.mk",
              "match": "\\bplain\\b(?=\\s+view\\b)"
            },
            {
              "name": "storage.modifier.mk",
              "match": "\\b(?:cpu|section)\\b(?=\\s+\")"
            },
            {
              "name": "storage.modifier.mk",
              "match": "\\bnaked\\b(?=\\s+[A-Z])"
            },
            {
              "name": "storage.modifier.mk",
              "match": "\\bopen\\b(?=\\s+(?:enum|type|error)\\b)"
            },
            {
              "name": "keyword.other.fuel.mk",
              "match": "\\bfuel\\b(?=\\s+[0-9])"
            }
          ]
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "variable.language.self.mk",
          "match": "\\b(?:self|Self)\\b"
        },
        {
          "name": "constant.language.mk",
          "match": "\\b(?:true|false|none)\\b"
        },
        {
          "name": "support.function.builtin.mk",
          "match": "\\b(?:some|ok|err)\\b(?=\\s*\\()"
        },
        {
          "name": "support.function.builtin.mk",
          "match": "\\b(?:Assert|Panic|Cast|Trunc|SizeOf|AlignOf|fields)\\b"
        },
        {
          "name": "support.type.builtin.mk",
          "match": "\\b(?:Target|Plain|Send|Share|Fields|EvalArena)\\b"
        },
        {
          "name": "storage.type.primitive.mk",
          "match": "\\b(?:i8|i16|i32|i64|u8|u16|u32|u64|int|uint|f32|f64|bool|char|void|never|str)\\b"
        }
      ]
    },
    "type-annotation": {
      "comment": "x: T, ): T and the like. := is a bind, not an annotation.",
      "match": "(:)(?!=)\\s*((?:(?:&|\\*|\\?|\\[\\]|\\[[0-9_A-Za-z]+\\]|mut\\s+|view\\s+)\\s*)*)(?:([a-z_][A-Za-z0-9_]*)(\\.))?([A-Z][A-Za-z0-9_]*)(!(?=[A-Za-z_&\\[(?*]))?",
      "captures": {
        "1": {
          "name": "punctuation.separator.annotation.mk"
        },
        "2": {
          "patterns": [
            {
              "include": "#keywords"
            },
            {
              "include": "#operators"
            },
            {
              "include": "#punctuation"
            },
            {
              "include": "#numbers"
            }
          ]
        },
        "3": {
          "name": "entity.name.namespace.mk"
        },
        "4": {
          "name": "punctuation.accessor.mk"
        },
        "5": {
          "name": "entity.name.type.mk"
        },
        "6": {
          "name": "keyword.operator.error-union.mk"
        }
      }
    },
    "error-union": {
      "comment": "E!T: the error set of a result.",
      "match": "\\b([A-Z][A-Za-z0-9_]*)(!)(?=[A-Za-z_&\\[(?*])",
      "captures": {
        "1": {
          "name": "entity.name.type.mk"
        },
        "2": {
          "name": "keyword.operator.error-union.mk"
        }
      }
    },
    "calls": {
      "patterns": [
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.mk"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.mk",
          "match": ":=|(?:\\+%|-%|\\*%|<<|>>|[-+*/%&|^])=|=(?!=)"
        },
        {
          "name": "keyword.operator.variadic.mk",
          "match": "\\.\\.\\."
        },
        {
          "name": "keyword.operator.range.mk",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.comparison.mk",
          "match": "==|!=|<=|>=|<(?!<)|>(?!>)"
        },
        {
          "name": "keyword.operator.logical.mk",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.arithmetic.mk",
          "match": "\\+%|-%|\\*%|<<|>>|[-+*/%&|^~]"
        },
        {
          "name": "keyword.operator.optional.mk",
          "match": "\\?"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.accessor.mk",
          "match": "\\."
        },
        {
          "name": "punctuation.separator.comma.mk",
          "match": ","
        },
        {
          "name": "punctuation.separator.colon.mk",
          "match": ":"
        },
        {
          "name": "punctuation.terminator.mk",
          "match": ";"
        }
      ]
    }
  }
}
