/// Returns the ShaderCode pair for a precompiled shader.
export CodeOf(spv: []u8, dxil: []u8): gpu.ShaderCode from spv, dxil {
    return gpu.ShaderCode(spirv: spv, dxil: dxil)
}

Sha256Hex(a: &Arena, data: []u8): encoding.Error|OutOfMemory!str from a {
    sum := hash.Sha256(data)
    return try encoding.HexEncode(a, sum[..])
}

NormalizeLfSha256(a: &Arena, data: []u8): encoding.Error|OutOfMemory!str from a {
    var buf := List[u8].New(a)
    var i := 0
    for i < data.Len() {
        if data[i] == 13 && i + 1 < data.Len() && data[i + 1] == 10 {
            try buf.Push(10)
            i += 2
        } else {
            try buf.Push(data[i])
            i += 1
        }
    }
    return try Sha256Hex(a, buf[..])
}

CheckOne(a: &Arena, name: str, hlsl: []u8, want_hlsl: str, spv: []u8, want_spv: str, dxil: []u8, want_dxil: str, stage: gpu.Stage, entry: str): gpu.Error|encoding.Error|OutOfMemory!void {
    got_hlsl := try NormalizeLfSha256(a, hlsl)
    if !got_hlsl.Eq(&want_hlsl) {
        _ = name
        fail gpu.Invalid(misuse: gpu.Misuse.BadShader, at: 0)
    }
    got_spv := try Sha256Hex(a, spv)
    if !got_spv.Eq(&want_spv) {
        fail gpu.Invalid(misuse: gpu.Misuse.BadShader, at: 1)
    }
    got_dxil := try Sha256Hex(a, dxil)
    if !got_dxil.Eq(&want_dxil) {
        fail gpu.Invalid(misuse: gpu.Misuse.BadShader, at: 2)
    }
    try gpu.CheckShader(gpu.ShaderCode(spirv: spv, dxil: dxil), stage, entry)
}

/// Verifies all embedded HLSL sources, SPIR-V/DXIL blob hashes, and shader interfaces. O(total bytes); allocates scratch in a.
export VerifyAll(a: &Arena): gpu.Error|encoding.Error|OutOfMemory!int {
    var count := 0
    try CheckOne(a, "ShadowVs", ShadowHlsl, ShadowVsHlslSha256, ShadowVsSpv, ShadowVsSpvSha256, ShadowVsDxil, ShadowVsDxilSha256, gpu.Stage.Vertex, "VsMain")
    count += 1
    try CheckOne(a, "MipVs", MipHlsl, MipVsHlslSha256, MipVsSpv, MipVsSpvSha256, MipVsDxil, MipVsDxilSha256, gpu.Stage.Vertex, "VsMain")
    count += 1
    try CheckOne(a, "MipPs", MipHlsl, MipPsHlslSha256, MipPsSpv, MipPsSpvSha256, MipPsDxil, MipPsDxilSha256, gpu.Stage.Fragment, "PsMain")
    count += 1
    try CheckOne(a, "SceneVs", SceneHlsl, SceneVsHlslSha256, SceneVsSpv, SceneVsSpvSha256, SceneVsDxil, SceneVsDxilSha256, gpu.Stage.Vertex, "VsMain")
    count += 1
    try CheckOne(a, "ScenePs", SceneHlsl, ScenePsHlslSha256, ScenePsSpv, ScenePsSpvSha256, ScenePsDxil, ScenePsDxilSha256, gpu.Stage.Fragment, "PsMain")
    count += 1
    try CheckOne(a, "InstancedVs", InstancedHlsl, InstancedVsHlslSha256, InstancedVsSpv, InstancedVsSpvSha256, InstancedVsDxil, InstancedVsDxilSha256, gpu.Stage.Vertex, "VsMain")
    count += 1
    try CheckOne(a, "InstancedPs", InstancedHlsl, InstancedPsHlslSha256, InstancedPsSpv, InstancedPsSpvSha256, InstancedPsDxil, InstancedPsDxilSha256, gpu.Stage.Fragment, "PsMain")
    count += 1
    try CheckOne(a, "OverlayVs", OverlayHlsl, OverlayVsHlslSha256, OverlayVsSpv, OverlayVsSpvSha256, OverlayVsDxil, OverlayVsDxilSha256, gpu.Stage.Vertex, "VsMain")
    count += 1
    try CheckOne(a, "OverlayPs", OverlayHlsl, OverlayPsHlslSha256, OverlayPsSpv, OverlayPsSpvSha256, OverlayPsDxil, OverlayPsDxilSha256, gpu.Stage.Fragment, "PsMain")
    count += 1
    try CheckOne(a, "BlurCs", BlurHlsl, BlurCsHlslSha256, BlurCsSpv, BlurCsSpvSha256, BlurCsDxil, BlurCsDxilSha256, gpu.Stage.Compute, "CsMain")
    count += 1
    return count
}
